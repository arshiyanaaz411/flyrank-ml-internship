import os, json
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import GroupKFold
from sklearn.metrics import mean_absolute_error
from sklearn.dummy import DummyRegressor
from sklearn.ensemble import HistGradientBoostingRegressor
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler

# ---- load the REAL starter dataset (30,000 rows) ----
if not os.path.exists("flyrank-ml-internship"):
    !git clone https://github.com/arshiyanaaz411/flyrank-ml-internship.git
DATA_PATH = "flyrank-ml-internship/data/raw/content_refresh_anonymized.csv"

raw = pd.read_csv(DATA_PATH)

# ctr in the file is a x100 percentage (0.76 = 0.76%). Convert to a fraction (0.0076)
# so that "impressions x gap" below is a real click count.
raw["ctr_frac"] = raw["ctr"] / 100

TARGET = "ctr_frac"
GROUP = "client_id"            # grouping only, never a feature
ID_COL = "content_id"          # pseudonym, only used in the queue
IMPR_COL = "impressions_90d"   # used for the low-volume rule, NOT a feature
AGE_COL = "content_age_days"
ARCHETYPE_COL = "content_type"
DROP_FEATURES = []

os.makedirs("work/outputs", exist_ok=True)
os.makedirs("work/figures", exist_ok=True)

df = raw.dropna(subset=[TARGET, GROUP]).reset_index(drop=True)

# avg_position == 0 means "no data", not rank zero
df["avg_position"] = df["avg_position"].replace(0, np.nan)

# missingness follows content_type, so use has_ flags instead of fillna(0)
for c in ["search_volume", "competition", "cpc", "word_count", "char_count", "avg_position"]:
    df[f"has_{c}"] = df[c].notna().astype(int)

# one-hot the categories
cats = pd.get_dummies(df[["content_type", "main_intent", "competition_level"]].astype(str),
                      prefix=["ct", "intent", "complvl"], dtype=int)
df = pd.concat([df, cats], axis=1)

# Features chosen by hand. EXCLUDED on purpose:
#  clicks_*, sessions_*, engagement/scroll/ai columns -> outcomes (clicks give away ctr)
#  impressions_*, days_with_impressions -> ctr's denominator
#  trend_pct, trend_direction -> label trap
#  client_id, content_id -> pseudonyms
BASE = ["search_volume", "competition", "cpc", "word_count", "char_count",
        "content_age_days", "days_since_last_update", "avg_position"]
FEATURES = BASE + [c for c in df.columns if c.startswith("has_")] + list(cats.columns)

X, y, g = df[FEATURES], df[TARGET], df[GROUP]
print("rows:", len(df), "| features:", len(FEATURES), "| clients:", g.nunique())

# Honest out-of-fold predictions: every row is predicted by a model that never saw its client
hgb = lambda: HistGradientBoostingRegressor(max_iter=300, learning_rate=0.05, random_state=42)
oof = np.full(len(df), np.nan)
oof_base = np.full(len(df), np.nan)
for tr, va in GroupKFold(5).split(X, y, groups=g):
    oof[va] = hgb().fit(X.iloc[tr], y.iloc[tr]).predict(X.iloc[va])
    oof_base[va] = DummyRegressor(strategy="median").fit(X.iloc[tr], y.iloc[tr]).predict(X.iloc[va])

df["pred_ctr"] = oof
df["gap"] = df["pred_ctr"] - df[TARGET]      # positive = performing below model expectation
MAE_MODEL = mean_absolute_error(y, oof)
MAE_BASE = mean_absolute_error(y, oof_base)
print(f"Grouped OOF MAE (CTR as a fraction): model {MAE_MODEL:.5f} | baseline {MAE_BASE:.5f}")
